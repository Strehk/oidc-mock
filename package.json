{
	"name": "oidc-mock",
	"version": "0.1.2",
	"description": "OpenID Connect provider for local development: users and claims in one YAML file, a login page to pick them, and a Vite plugin that makes it work behind --host.",
	"license": "MIT",
	"author": "Tade Strehk <tade@strehk.eu>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/strehk/oidc-mock.git"
	},
	"homepage": "https://github.com/strehk/oidc-mock#readme",
	"bugs": "https://github.com/strehk/oidc-mock/issues",
	"type": "module",
	"keywords": [
		"oidc",
		"openid-connect",
		"oauth2",
		"mock",
		"dev-server",
		"vite-plugin"
	],
	"engines": {
		"node": ">=20"
	},
	"bin": {
		"oidc-mock": "dist/cli.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./vite": {
			"types": "./dist/vite.d.ts",
			"default": "./dist/vite.js"
		}
	},
	"files": [
		"dist",
		"examples/oidc-mock.yaml"
	],
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"dev": "bun --watch src/cli.ts --config examples/oidc-mock.yaml",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "bun run typecheck && bun test && bun run build"
	},
	"dependencies": {
		"jose": "^6.2.12",
		"yaml": "^2.9.1",
		"zod": "^4.6.5"
	},
	"peerDependencies": {
		"vite": ">=5"
	},
	"peerDependenciesMeta": {
		"vite": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/bun": "latest",
		"@types/node": "^26.6.3",
		"openid-client": "^6.8.8",
		"typescript": "^7.0.2",
		"vite": "^8.3.1"
	},
	"publishConfig": {
		"access": "public"
	}
}
